# Optional local llama.cpp / OpenAI-compatible chat completions endpoint
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=local-model
LLM_API_KEY=not-needed
# Set to true to use the configured local model for invoice extraction
USE_LOCAL_LLM=false
# Optional Windows path to tesseract.exe if it is not on PATH
TESSERACT_CMD=
